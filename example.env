# 32+ characters secret key
BETTER_AUTH_SECRET=

# PostgreSQL is required. URL-encode special characters in the password.
# No URL query parameters; TLS certificate verification is always enabled.
DATABASE_URL=postgresql://hoursbooster:REPLACE_PASSWORD@postgres.example.com:5432/hoursbooster
# For local runs, path to the PostgreSQL CA certificate. Compose reads this file
# from TLS_CERTS_DIR/database-ca.pem inside the container.
DATABASE_CA_FILE=./certs/database-ca.pem

# Default: refuse unauthenticated operation. Enable only for a trusted local instance.
ALLOW_ANONYMOUS=false
BETTER_AUTH_TELEMETRY=0

# Change if hosting
# Replace this example domain with your own. Both origins must be identical HTTPS.
BETTER_AUTH_URL=https://hours.example.com
ORIGIN=https://hours.example.com
TLS_CERT_FILE=./certs/fullchain.pem
TLS_KEY_FILE=./certs/privkey.pem
PORT=8443
# Keep local by default. Set 0.0.0.0 only for an authenticated public deployment.
HTTPS_BIND_IP=127.0.0.1
# Optional host directory mounted read-only by Compose:
TLS_CERTS_DIR=./certs

# Display name for the local account (optional)
LOCAL_ACCOUNT_NAME=

# OpenID Connect provider configuration (optional)
OIDC_PROVIDER_NAME=
OIDC_PROVIDER_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=

# Optional direct Steam OpenID login to the panel. Separate from account boosting.
# A closed allowlist is required when enabled; use your own SteamID64 values privately.
STEAM_LOGIN_ENABLED=false
STEAM_ALLOWED_IDS=
