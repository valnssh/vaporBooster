# Copy to .private/full-stack/settings.env; never commit the populated file.
# Two different real DNS names covered by the nginx certificate.
# Local DNS may point both names to the private address of your VM.
HOURS_DOMAIN=hours.example.com
AUTH_DOMAIN=auth.example.com
# Comma-separated SteamID64 values allowed to sign in to the panel.
# Replace the placeholder with your own ID(s); no password or Steam API key.
STEAM_ALLOWED_IDS=YOUR_STEAMID64
# Change only if this private Docker subnet conflicts with an existing network.
EDGE_SUBNET=172.28.0.0/24
